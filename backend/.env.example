# query-mind Environment Variables
# Copy this file to .env and fill in your values

# LLM Provider Configuration. User-owned credentials are preferred in hybrid mode.
# The deployment provider/key is a controlled fallback and may be omitted in
# hybrid/byok_required mode.
LLM_CREDENTIAL_MODE=hybrid
LLM_CREDENTIAL_VALIDATION_TIMEOUT_SECONDS=10
LLM_CREDENTIAL_VALIDATION_RATE_LIMIT_ATTEMPTS=10
LLM_CREDENTIAL_VALIDATION_RATE_LIMIT_WINDOW_SECONDS=60
LLM_CREDENTIAL_MAX_BYTES=8192
LLM_USAGE_RETENTION_DAYS=90
DEPLOYMENT_LLM_TRIAL_CALL_LIMIT=10
DEPLOYMENT_LLM_PRIVILEGED_USER_IDS=
LLM_PROVIDER=gemini

# Groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_ALLOWED_MODELS=llama-3.3-70b-versatile

# Google Gemini (also accepts GOOGLE_API_KEY)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
GEMINI_ALLOWED_MODELS=gemini-2.0-flash

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_ALLOWED_MODELS=gpt-5-mini,gpt-4.1-mini

# Database Agent (tool-calling loop)
AGENT_MODE=pipeline
AGENT_MODEL=
AGENT_MAX_TOOL_CALLS=20
AGENT_WALL_CLOCK_SECONDS=120
AGENT_PREVIEW_ROWS=20
AGENT_MAX_TABLES_PER_CALL=5
AGENT_TOOL_OUTPUT_CHARS=12000
AGENT_MAX_TABLES_LISTED=100
AGENT_MAX_COLUMNS_PER_TABLE=80
AGENT_MAX_CELL_CHARS=500
AGENT_COMPACTION_TOKEN_THRESHOLD=6000
AGENT_MAX_LIVE_QUERIES=10
AGENT_MAX_NOTES=20
AGENT_QUERY_TIMEOUT_SECONDS=10
# Comma-separated extra Postgres schema names to hide during DB sync (defaults include Supabase platform schemas).
CATALOG_EXCLUDED_SCHEMAS=

# App Configuration
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,https://your-production-app.com

# Direct app database connection used by SQLAlchemy repositories and Alembic.
# For Supabase, use the direct Postgres connection string, not the REST API URL.
APP_DATABASE_URL=postgresql+psycopg2://postgres:password@db.your-project-id.supabase.co:5432/postgres

# Optional local/demo database used only for BACKEND_DEV_MODE seeding of a connected analytics DB.
DATABASE_URL=postgresql://user:password@localhost:5432/query_mind_demo

# Redis / Celery Configuration
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_DEFAULT_QUEUE=default
CELERY_SCHEDULED_QUEUE=scheduled
CELERY_TEMPLATES_QUEUE=templates
CELERY_INTERACTIVE_QUEUE=interactive
CELERY_DASHBOARDS_QUEUE=dashboards
CELERY_SEMANTICS_QUEUE=semantics
CELERY_SUGGESTIONS_QUEUE=suggestions
CELERY_DISPATCH_LOCK_SECONDS=900
CELERY_WORKER_CONCURRENCY=4

# Durable agent progress streaming. Requires Redis and the interactive Celery worker.
CHAT_STREAMING_ENABLED=true
CHAT_RUN_EVENT_TTL_SECONDS=3600
CHAT_RUN_EVENT_MAXLEN=500
CHAT_RUN_HEARTBEAT_SECONDS=15
CHAT_RUN_MAX_ACTIVE_PER_USER=3

# AI dashboard generation (prompt-to-dashboard).
DASHBOARD_AI_ENABLED=true
DASHBOARD_AI_MAX_WIDGETS=8
DASHBOARD_AI_DEFAULT_WIDGETS=6
DASHBOARD_AI_MAX_ACTIVE_PER_USER=1
DASHBOARD_AI_MAX_PROMPT_CHARS=2048
DASHBOARD_RUN_EVENT_TTL_SECONDS=3600
DASHBOARD_RUN_EVENT_MAXLEN=500
DASHBOARD_RUN_HEARTBEAT_SECONDS=15

# Versioned semantic catalog. Manual editing works without Redis/Celery;
# AI suggestions use the semantics queue on the general worker.
SEMANTIC_LAYER_ENABLED=true
SEMANTIC_SUGGESTIONS_ENABLED=true
SEMANTIC_CONTEXT_MAX_DEFINITIONS=20
SEMANTIC_CONTEXT_MAX_CHARACTERS=12000
SEMANTIC_PREVIEW_TIMEOUT_SECONDS=5
SEMANTIC_RELATIONSHIP_SAMPLE_LIMIT=1000
SEMANTIC_SUGGESTION_MAX_CANDIDATES=25

# Schema-aware question discovery. The deterministic layer works without workers;
# optional AI enrichment uses one cached job on the suggestions queue.
QUESTION_SUGGESTIONS_ENABLED=true
QUESTION_SUGGESTIONS_AI_ENABLED=true
QUESTION_SUGGESTIONS_MAX_CONTEXT_CHARACTERS=12000
QUESTION_SUGGESTIONS_MAX_PER_SURFACE=8
QUESTION_SUGGESTIONS_REFRESH_COOLDOWN_SECONDS=60
QUESTION_SUGGESTIONS_STALE_RUN_SECONDS=300

# Auth user-check cache TTL in seconds (0 disables; a deactivated user may
# retain access for up to this long).
AUTH_USER_CACHE_TTL_SECONDS=60

# App-database connection pools. The read and write engines use separate
# pools, but their defaults keep the combined per-process ceiling at 15.
APP_DB_WRITE_POOL_SIZE=5
APP_DB_WRITE_MAX_OVERFLOW=5
APP_DB_READ_POOL_SIZE=5
APP_DB_READ_MAX_OVERFLOW=0
APP_DB_POOL_TIMEOUT_SECONDS=30

# Database Connection Guardrails
DB_CONNECT_TIMEOUT_SECONDS=5
DB_CONNECT_RATE_LIMIT_ATTEMPTS=10
DB_CONNECT_RATE_LIMIT_WINDOW_SECONDS=60
DB_CONNECT_ALLOWED_HOSTS=
DB_CONNECT_ALLOWED_CIDRS=
DB_CONNECT_ALLOW_PRIVATE_IN_DEV=true
CONNECTION_HEALTH_RETENTION_DAYS=90
CONNECTION_MAINTENANCE_BATCH_SIZE=100
CONNECTION_SCOPE_CACHE_TTL_SECONDS=60
CONNECTION_DIAGNOSTIC_MAX_OBJECTS=5000
CONNECTION_TLS_CERT_MAX_BYTES=65536

# Database Credential Encryption (MANDATORY FOR PROD)
# Generate a Fernet key using: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=REQUIRED_FOR_PRODUCTION_SECURITY

# Supabase Auth Configuration
# Go to Supabase Project Settings -> API / JWT Settings
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_JWT_SECRET=REQUIRED_FOR_SECURE_AUTH_VERIFICATION

# Lemon Squeezy (Payments)
LEMON_SQUEEZY_WEBHOOK_SECRET=your_webhook_secret_here
LEMON_SQUEEZY_API_KEY=your_api_key_here

# Mode Configuration
BACKEND_DEV_MODE=false
DEV_USER_ID=00000000-0000-0000-0000-000000000000
DEV_USER_EMAIL=dev@query-mind.com
